# =============================================================================
# Auto Centar DEA — varijable okruženja
# Kopirajte u .env.local (lokalno). Na Cloudflareu: NEXT_PUBLIC_* i ALLOW_INDEXING
# su varijable pri BUILDU, a tajni ključevi su Worker tajne (npx wrangler secret put).
# Vidi README, poglavlje 4. NIKAD ne commitajte .env.local ni .dev.vars.
# =============================================================================

# --- Supabase (Project Settings → API Keys) ---------------------------------
# Javni URL projekta
NEXT_PUBLIC_SUPABASE_URL=https://VAS-PROJEKT.supabase.co
# Publishable key (sb_publishable_…) — smije biti javan, zaštitu daje RLS.
# Stariji projekti: umjesto ovoga može se postaviti NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Secret key (sb_secret_…) — SAMO server. Zaobilazi RLS!
# Koristi se samo za zaprimanje upita (s ograničenjem) i dodavanje administratora.
# Stariji projekti: SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# --- Adresa stranice ---------------------------------------------------------
# Kanonska adresa (bez / na kraju). OBAVEZNO u produkciji: https://autocentardea.ba
# (dok domena ne radi: https://autocentar-dea.<račun>.workers.dev). Lokalno može ostati prazno.
NEXT_PUBLIC_SITE_URL=
# Indeksiranje u tražilicama: uključite ("true") TEK na pravoj produkcijskoj domeni.
# Bez ovoga robots.txt zabranjuje indeksiranje (preview adrese ne ulaze u Google).
ALLOW_INDEXING=false

# --- Email obavijesti o upitima (Resend) — NEOBAVEZNO ------------------------
# Dok nije postavljeno, upiti se spremaju u bazu i vidljivi su u adminu, ali
# se email ne šalje. FROM mora biti na domeni potvrđenoj u Resendu.
RESEND_API_KEY=
RESEND_FROM=
# primjer: RESEND_FROM="Auto Centar DEA <upiti@autocentardea.ba>"

# --- Cloudflare Turnstile (zaštita od botova) — NEOBAVEZNO -------------------
# Postavite OBA ključa istodobno. Bez njih štite ograničenje učestalosti i honeypot.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Automatsko brisanje starih upita (Cloudflare Cron) — OBAVEZNO u produkciji
# Dnevno briše IP sažetke starije od 30 dana i upite starije od 24 mjeseca
# (rokovi objavljeni na /privatnost). Cron (worker.ts) ga šalje cron ruti.
# Generirajte nasumično: openssl rand -hex 32
CRON_SECRET=
